    {
      "name": "03 · Verificación de procesamiento (LocalStack)",
      "item": [
        {
          "name": "Evento del 202 argyle → COMPLETADO",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Espera a que la Lambda procese el evento (reintenta la misma petición hasta 10 veces).",
                  "const n = parseInt(pm.collectionVariables.get('poll_lastEventId') || '0');",
                  "if (n > 0) { setTimeout(() => {}, 1500); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const estado = body.Item && body.Item.status ? body.Item.status.S : null;",
                  "const key = 'poll_lastEventId';",
                  "const n = parseInt(pm.collectionVariables.get(key) || '0');",
                  "if (estado !== 'COMPLETADO' && n < 10) {",
                  "  pm.collectionVariables.set(key, String(n + 1));",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.unset(key);",
                  "  pm.test('El evento quedó COMPLETADO en la tabla de idempotencia', () => pm.expect(estado).to.eql('COMPLETADO'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.0"
              },
              {
                "key": "X-Amz-Target",
                "value": "DynamoDB_20120810.GetItem"
              },
              {
                "key": "Authorization",
                "value": "AWS4-Hmac-SHA256 Credential=test/20260101/us-east-1/dynamodb/aws4_request, SignedHeaders=host, Signature=x"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"TableName\":\"{{tableName}}\",\"Key\":{\"eventId\":{\"S\":\"{{lastEventId}}\"}}}"
            },
            "url": {
              "raw": "{{localstackUrl}}/",
              "host": [
                "{{localstackUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Consulta DynamoDB en LocalStack hasta ver COMPLETADO."
          }
        }
      ]
    },
